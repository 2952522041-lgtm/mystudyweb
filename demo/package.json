{
  "name": "sites-project",
  "productName": "Yeyu",
  "description": "页语——本地课程知识库、PDF 随页翻译与 AI 答疑阅读器",
  "author": "Yeyu Team",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "predev": "node scripts/copy-pdf-worker.mjs",
    "dev": "vinext dev",
    "prebuild": "node scripts/copy-pdf-worker.mjs",
    "build": "node scripts/run-vinext.mjs build",
    "prepages": "node scripts/copy-pdf-worker.mjs && VINEXT_EXPORT=1 node scripts/run-vinext.mjs build",
    "pages": "node scripts/build-github-pages.mjs",
    "start": "wrangler dev --config dist/server/wrangler.json",
    "test": "node --test --experimental-strip-types tests/*.test.ts",
    "lint": "oxlint app lib tests electron",
    "desktop:web": "node scripts/copy-pdf-worker.mjs && VINEXT_EXPORT=1 node scripts/run-vinext.mjs build",
    "desktop:compile": "tsc -p electron/tsconfig.json && node scripts/write-electron-commonjs.mjs && node scripts/bundle-preload.mjs",
    "desktop:build": "pnpm desktop:web && pnpm desktop:compile && electron-forge package",
    "desktop:make": "pnpm desktop:web && pnpm desktop:compile && electron-forge make",
    "desktop:test": "pnpm desktop:compile && node --test --experimental-strip-types tests/electron-launch.test.ts tests/electron-workspace.test.ts",
    "format": "oxfmt"
  },
  "dependencies": {
    "@base-ui/react": "1.7.0",
    "@shadcn/react": "0.3.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "date-fns": "4.1.0",
    "electron-squirrel-startup": "^1.0.1",
    "embla-carousel-react": "8.5.2",
    "input-otp": "1.4.2",
    "katex": "^0.18.4",
    "lucide-react": "1.31.0",
    "pdfjs-dist": "^6.2.108",
    "react": "19.2.6",
    "react-day-picker": "9.8.1",
    "react-dom": "19.2.6",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "4.5.8",
    "react-server-dom-webpack": "19.2.6",
    "recharts": "3.8.0",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "shadcn": "4.18.0",
    "tailwind-merge": "3.6.0",
    "tw-animate-css": "1.4.0",
    "vinext": "1.0.0-beta.5"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "4.20260515.1",
    "@electron-forge/cli": "^7.11.2",
    "@electron-forge/maker-squirrel": "^7.11.2",
    "@electron-forge/maker-zip": "^7.11.2",
    "@openai/sites-vite-plugin": "0.2.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "electron": "^44.0.0",
    "esbuild": "0.27.3",
    "oxfmt": "0.61.0",
    "oxlint": "1.76.0",
    "oxlint-tsgolint": "7.0.2001",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module",
  "main": "electron/dist/main.js"
}

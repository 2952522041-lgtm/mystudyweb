@@ -0,0 +1,222 @@
+export const MAX_DIFF_CELLS = 40_000;
+
+export interface SummaryDiffSegment {
+  kind: 'equal' | 'added' | 'removed';
+  text: string;
+}
+
+export interface SummaryDiff {
+  segments: SummaryDiffSegment[];
+  added: number;
+  removed: number;
+  unchanged: number;
+  coarse: boolean;
+}
+
+interface FenceState {
+  char: '`' | '~';
+  length: number;
+}
+
+const FENCE_OPEN_RE = /^( {0,3})(`{3,}|~{3,})(.*)$/;
+const FENCE_CLOSE_RE = /^( {0,3})(`+|~+)\s*$/;
+
+/** Detect a fence opening line; returns null when the line does not open a fence. */
+function matchFenceOpen(line: string): FenceState | null {
+  const match = FENCE_OPEN_RE.exec(line);
+  if (!match) return null;
+  const marker = match[2];
+  const info = match[3];
+  const char = marker[0] as '`' | '~';
+  // A backtick info string must not itself contain a backtick.
+  if (char === '`' && info.includes('`')) return null;
+  return { char, length: marker.length };
+}
+
+/** Detect a fence closing line for the currently open fence. */
+function isFenceClose(line: string, fence: FenceState): boolean {
+  const match = FENCE_CLOSE_RE.exec(line);
+  if (!match) return false;
+  const marker = match[2];
+  return marker[0] === fence.char && marker.length >= fence.length;
+}
+
+/**
+ * Split normalized summary text into trimmed paragraphs.
+ *
+ * CRLF and lone CR are normalized to LF. Outside fenced code blocks and
+ * `$$` display-math blocks one or more whitespace-only lines separate
+ * paragraphs. Outer whitespace of each paragraph is trimmed and empty
+ * paragraphs are omitted; interior line breaks and spaces are preserved.
+ */
+export function splitSummaryParagraphs(text: string): string[] {
+  const normalized = text.replace(/\r\n?/g, '\n');
+  const lines = normalized.split('\n');
+  const paragraphs: string[] = [];
+  let buffer: string[] = [];
+  let fence: FenceState | null = null;
+  let inMath = false;
+
+  const flush = () => {
+    if (buffer.length === 0) return;
+    const paragraph = buffer.join('\n').trim();
+    if (paragraph !== '') paragraphs.push(paragraph);
+    buffer = [];
+  };
+
+  for (const line of lines) {
+    if (fence) {
+      buffer.push(line);
+      if (isFenceClose(line, fence)) fence = null;
+      continue;
+    }
+
+    if (inMath) {
+      buffer.push(line);
+      if (line.trim() === '$$') inMath = false;
+      continue;
+    }
+
+    const opening = matchFenceOpen(line);
+    if (opening) {
+      fence = opening;
+      buffer.push(line);
+      continue;
+    }
+
+    if (line.trim() === '$$') {
+      inMath = true;
+      buffer.push(line);
+      continue;
+    }
+
+    if (line.trim() === '') {
+      flush();
+      continue;
+    }
+
+    buffer.push(line);
+  }
+
+  flush();
+  return paragraphs;
+}
+
+/** LCS-based middle diff. Tie on equal-length alternatives removes from `before` first. */
+function diffMiddle(before: string[], after: string[]): SummaryDiffSegment[] {
+  const n = before.length;
+  const m = after.length;
+  const lcs: number[][] = Array.from({ length: n + 1 }, () =>
+    Array.from({ length: m + 1 }, () => 0),
+  );
+
+  for (let i = n - 1; i >= 0; i -= 1) {
+    for (let j = m - 1; j >= 0; j -= 1) {
+      if (before[i] === after[j]) {
+        lcs[i][j] = lcs[i + 1][j + 1] + 1;
+      } else {
+        lcs[i][j] = Math.max(lcs[i + 1][j], lcs[i][j + 1]);
+      }
+    }
+  }
+
+  const segments: SummaryDiffSegment[] = [];
+  let i = 0;
+  let j = 0;
+  while (i < n && j < m) {
+    if (before[i] === after[j]) {
+      segments.push({ kind: 'equal', text: before[i] });
+      i += 1;
+      j += 1;
+    } else if (lcs[i + 1][j] >= lcs[i][j + 1]) {
+      segments.push({ kind: 'removed', text: before[i] });
+      i += 1;
+    } else {
+      segments.push({ kind: 'added', text: after[j] });
+      j += 1;
+    }
+  }
+  while (i < n) {
+    segments.push({ kind: 'removed', text: before[i] });
+    i += 1;
+  }
+  while (j < m) {
+    segments.push({ kind: 'added', text: after[j] });
+    j += 1;
+  }
+  return segments;
+}
+
+/**
+ * Compare two summaries paragraph by paragraph.
+ *
+ * Shared prefix/suffix paragraphs are emitted as `equal` without an LCS
+ * matrix. The remaining middle is diffed with an LCS when its cell product
+ * is within MAX_DIFF_CELLS; otherwise a bounded fallback removes the whole
+ * before middle then adds the whole after middle and flags `coarse`.
+ */
+export function compareSummaryParagraphs(before: string, after: string): SummaryDiff {
+  const beforeParagraphs = splitSummaryParagraphs(before);
+  const afterParagraphs = splitSummaryParagraphs(after);
+
+  let prefix = 0;
+  while (
+    prefix < beforeParagraphs.length &&
+    prefix < afterParagraphs.length &&
+    beforeParagraphs[prefix] === afterParagraphs[prefix]
+  ) {
+    prefix += 1;
+  }
+
+  let beforeEnd = beforeParagraphs.length;
+  let afterEnd = afterParagraphs.length;
+  while (
+    beforeEnd > prefix &&
+    afterEnd > prefix &&
+    beforeParagraphs[beforeEnd - 1] === afterParagraphs[afterEnd - 1]
+  ) {
+    beforeEnd -= 1;
+    afterEnd -= 1;
+  }
+
+  const beforeMiddle = beforeParagraphs.slice(prefix, beforeEnd);
+  const afterMiddle = afterParagraphs.slice(prefix, afterEnd);
+  const suffix = beforeParagraphs.slice(beforeEnd);
+
+  const segments: SummaryDiffSegment[] = [];
+  let added = 0;
+  let removed = 0;
+  let unchanged = 0;
+
+  for (let i = 0; i < prefix; i += 1) {
+    segments.push({ kind: 'equal', text: beforeParagraphs[i] });
+    unchanged += 1;
+  }
+
+  let coarse = false;
+  if (beforeMiddle.length * afterMiddle.length > MAX_DIFF_CELLS) {
+    coarse = true;
+    for (const text of beforeMiddle) {
+      segments.push({ kind: 'removed', text });
+      removed += 1;
+    }
+    for (const text of afterMiddle) {
+      segments.push({ kind: 'added', text });
+      added += 1;
+    }
+  } else {
+    for (const segment of diffMiddle(beforeMiddle, afterMiddle)) {
+      segments.push(segment);
+      if (segment.kind === 'equal') unchanged += 1;
+      else if (segment.kind === 'added') added += 1;
+      else removed += 1;
+    }
+  }
+
+  for (const text of suffix) {
+    segments.push({ kind: 'equal', text });
+    unchanged += 1;
+  }
+
+  return { segments, added, removed, unchanged, coarse };
+}

+'use client';
+
+import {useId, useMemo, useState} from 'react';
+import {compareSummaryParagraphs} from '../lib/summary-diff.ts';
+
+const PAGE_SIZE = 20;
+
+export interface SummaryDiffViewProps {
+  before: string;
+  after: string;
+  beforeLabel?: string;
+  afterLabel?: string;
+}
+
+export function SummaryDiffView({
+  before,
+  after,
+  beforeLabel = '起始版本',
+  afterLabel = '对比版本',
+}: SummaryDiffViewProps) {
+  return (
+    <SummaryDiffViewContent
+      key={JSON.stringify([before, after])}
+      before={before}
+      after={after}
+      beforeLabel={beforeLabel}
+      afterLabel={afterLabel}
+    />
+  );
+}
+
+function SummaryDiffViewContent({
+  before,
+  after,
+  beforeLabel = '起始版本',
+  afterLabel = '对比版本',
+}: SummaryDiffViewProps) {
+  const [changesOnly, setChangesOnly] = useState(true);
+  const [visibleLimit, setVisibleLimit] = useState(PAGE_SIZE);
+  const headingId = useId();
+  const diff = useMemo(() => compareSummaryParagraphs(before, after), [before, after]);
+
+  const visibleSegments = diff.segments.filter((item) => !changesOnly || item.kind !== 'equal');
+  const rows = visibleSegments.slice(0, visibleLimit);
+  const bothEmpty = diff.segments.length === 0;
+  const unchangedOnly = diff.added === 0 && diff.removed === 0 && diff.unchanged > 0;
+
+  return (
+    <section aria-labelledby={headingId} className="space-y-4">
+      <div className="space-y-2">
+        <h2 id={headingId} className="text-lg font-semibold">总结文字差异</h2>
+        <div className="flex flex-wrap gap-x-4 gap-y-1 text-sm text-muted-foreground">
+          <span>起始版本：{beforeLabel}</span>
+          <span>对比版本：{afterLabel}</span>
+        </div>
+        <p aria-live="polite" className="text-sm">
+          新增 {diff.added} 段 · 移除 {diff.removed} 段 · 未变 {diff.unchanged} 段
+        </p>
+      </div>
+
+      <label className="inline-flex cursor-pointer items-center gap-2 rounded-sm focus-within:outline-none focus-within:ring-2 focus-within:ring-ring focus-within:ring-offset-2">
+        <input
+          type="checkbox"
+          checked={changesOnly}
+          onChange={(event) => {
+            setChangesOnly(event.currentTarget.checked);
+            setVisibleLimit(PAGE_SIZE);
+          }}
+          className="size-4 accent-primary focus-visible:outline-none"
+        />
+        <span>只看改动</span>
+      </label>
+
+      {bothEmpty ? <p aria-live="polite">没有可比较的总结文字。</p> : null}
+      {unchangedOnly ? <p aria-live="polite">总结文字没有变化。</p> : null}
+      {diff.coarse ? <p aria-live="polite">内容较长，显示简化差异。</p> : null}
+
+      {rows.length > 0 ? (
+        <ol aria-label="差异段落" className="m-0 list-none space-y-3 p-0">
+          {rows.map((item, index) => (
+            <li
+              key={`${item.kind}-${index}`}
+              data-diff-kind={item.kind}
+              className="rounded-md border p-3"
+            >
+              <span className="mb-2 inline-block text-sm font-medium">
+                {item.kind === 'equal' ? '未变' : item.kind === 'added' ? '新增' : '移除'}
+              </span>
+              <p data-diff-text={item.text} className="whitespace-pre-wrap break-words [overflow-wrap:anywhere]">
+                {item.text}
+              </p>
+            </li>
+          ))}
+        </ol>
+      ) : null}
+
+      {visibleSegments.length > visibleLimit ? (
+        <button
+          type="button"
+          onClick={() => setVisibleLimit((limit) => limit + PAGE_SIZE)}
+          className="rounded-md border px-3 py-2 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2"
+        >
+          显示更多
+        </button>
+      ) : null}
+    </section>
+  );
+}
